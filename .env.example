# Copy this file to `.env` in the project root and fill in real values.
# Variable names must match `*_env` fields in `config.yaml` (defaults below).

# n8n REST API (see `n8n_api.api_key_env`, default N8N_API_KEY)
N8N_API_KEY=your-n8n-api-key-here

# Langfuse metrics API (see `langfuse_api.public_key_env` / `secret_key_env`)
LANGFUSE_PUBLIC_KEY=pk-lf-your-key
LANGFUSE_SECRET_KEY=sk-lf-your-key
